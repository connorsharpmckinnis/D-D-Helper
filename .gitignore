# D&D Helper — ignore rules for a public repository.
# Tracks source, lockfile, and docs. Leaves out secrets, local envs,
# model weights, and saved campaign data.

# --- Secrets and credentials ---
.env
.env.*
!.env.example
!.env.sample

*.pem
*.key
*.crt
*.cer
*.p12
*.pfx
*.jks
id_rsa
id_ed25519
*.keystore
secrets/
credentials/
credentials.json
service-account*.json
**/api_keys*
**/*secret*

# Gradio local TLS material and runtime cache
.gradio/
flagged/
gradio_cached_examples/

# --- Operational / user data ---
# Saved character sheets and world catalogs are personal campaign data.
character.json
world_catalog.json
data/
catalogs/
saves/
campaigns/
sessions/
exports/
backups/

# Notebooks and scripts sometimes drop ad-hoc JSON next to the code.
*.local.json
*-backup.json
*.bak

# --- Models and weights ---
*.pt
*.pth
*.ckpt
*.onnx
*.safetensors
*.gguf
*.tflite
*.h5
*.pb
*.pkl
*.pickle
*.joblib
models/
checkpoints/
weights/
runs/
wandb/
mlruns/
lightning_logs/

# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Virtual environments (uv and the venv path in the README)
.venv/
venv/
env/
ENV/

# Test, type, and lint caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.tox/
.nox/
.coverage
.coverage.*
htmlcov/
coverage.xml
*.cover
.hypothesis/
.cache/

# --- Jupyter ---
.ipynb_checkpoints/
*/.ipynb_checkpoints/*
profile_default/
ipython_config.py

# --- Editors and OS ---
.DS_Store
.AppleDouble
.LSOverride
._*
Thumbs.db
ehthumbs.db
Desktop.ini
.idea/
.vscode/
*.swp
*.swo
*~

# --- Logs and local tooling ---
*.log
logs/
tmp/
temp/
.python-version
